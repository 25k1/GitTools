#include <winres.h>

#include "../src/Version.h"

1 24 "app.manifest"

diffLineInserted WAVE "diffLineInserted.wav"
diffLineDeleted  WAVE "diffLineDeleted.wav"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    GITTOOLS_VERSION_FIELDS
 PRODUCTVERSION GITTOOLS_VERSION_FIELDS
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "gittools"
            VALUE "FileVersion",      GITTOOLS_VERSION_FULL
            VALUE "InternalName",     "gittools"
            VALUE "OriginalFilename", "gittools.exe"
            VALUE "ProductName",      "gittools"
            VALUE "ProductVersion",   GITTOOLS_VERSION_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
